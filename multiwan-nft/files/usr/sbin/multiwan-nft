#!/bin/sh

MULTIWAN_NFT_LIB_ROOT="${MULTIWAN_NFT_LIB_ROOT:-/lib}"
. "$MULTIWAN_NFT_LIB_ROOT/functions.sh"
. "${IPKG_INSTROOT}/usr/share/libubox/jshn.sh"
. "$MULTIWAN_NFT_LIB_ROOT/functions/network.sh"
. "$MULTIWAN_NFT_LIB_ROOT/multiwan-nft/multiwan_nft.sh"

command_help() {
	local cmd="$1"
	local help="$2"

	echo "$(printf "%-25s%s" "${cmd}" "${help}")"
}

help()
{
	cat <<EOF
Syntax: multiwan-nft [command]

Available commands:
EOF
	command_help "start" "Load nftables rules, ip rules and ip routes"
	command_help "stop" "Unload nftables rules, ip rules and ip routes"
	command_help "restart" "Reload nftables rules, ip rules and ip routes"
	command_help "ifup <iface>" "Load rules and routes for specific interface"
	command_help "ifdown <iface>" "Unload rules and routes for specific interface"
	command_help "interfaces" "Show interfaces status"
	command_help "policies" "Show currently active policy"
	command_help "connected" "Show directly connected networks"
	command_help "rules" "Show active rules"
	command_help "status" "Show all status"
	command_help "internal <ipv4|ipv6>" "Show internal configuration <default: ipv4>"
	command_help "use <iface> <cmd>" "Run a command bound to <iface> and avoid multiwan-nft rules"
}

ifdown() {
	if [ -z "${1:-}" ]; then
		echo "Error: Expecting interface. Usage: multiwan-nft ifdown <interface>" >&2
		return 2
	fi

	if [ "$#" -gt 1 ]; then
		echo "Error: Too many arguments. Usage: multiwan-nft ifdown <interface>" >&2
		return 2
	fi

	multiwan_nft_init || return
	multiwan_nft_interface_hotplug_shutdown "$1" 1
}

ifup() {
	if [ -z "${1:-}" ]; then
		echo "Expecting interface. Usage: multiwan-nft ifup <interface>" >&2
		return 2
	fi

	if [ "$#" -gt 1 ]; then
		echo "Too many arguments. Usage: multiwan-nft ifup <interface>" >&2
		return 2
	fi

	multiwan_nft_init || return
	multiwan_nft_ifup "$1" "cmd"
}

interfaces()
{
	config_load 'multiwan-nft' || return

	echo "Interface status:"
	config_foreach multiwan_nft_report_iface_status interface || return
	echo
}

policies()
{
	echo "Current ipv4 policies:"
	multiwan_nft_report_policies_v4 || return
	echo
	[ "$NO_IPV6" -eq 0 ] || return 0
	echo "Current ipv6 policies:"
	multiwan_nft_report_policies_v6 || return
	echo
}

connected()
{
	echo "Directly connected ipv4 networks:"
	multiwan_nft_report_connected_v4 || return
	echo
	[ "$NO_IPV6" -eq 0 ] || return 0
	echo "Directly connected ipv6 networks:"
	multiwan_nft_report_connected_v6 || return
	echo
}

rules()
{
	echo "Active ipv4 user rules:"
	multiwan_nft_report_rules_v4 || return
	echo
	[ "$NO_IPV6" -eq 0 ] || return 0
	echo "Active ipv6 user rules:"
	multiwan_nft_report_rules_v6 || return
	echo
}

status()
{
	interfaces || return
	policies || return
	connected || return
	rules
}

internal()
{
	local family="${1:-ipv4}"
	local dash="-------------------------------------------------"

	if [ -f "/etc/openwrt_release" ]; then
		. /etc/openwrt_release
	fi

	local ip output

	if [ "$family" = "ipv6" ]; then
		ip="$IP6"
	else
		ip="$IP4"
	fi

	echo "Software-Version"
	echo "$dash"

	if [ -n "${DISTRIB_RELEASE:-}" ]; then
		echo "OpenWrt - $DISTRIB_RELEASE"
	else
		echo "OpenWrt - unknown"
	fi

	echo ""
	echo "Output of \"$ip a show\""
	echo "$dash"
	output="$($ip a show)"
	if [ "$output" != "" ]; then
		echo "$output"
	else
		echo "No data found"
	fi

	echo ""
	echo "Output of \"$ip route show\""
	echo "$dash"
	output="$($ip route show)"
	if [ "$output" != "" ]; then
		echo "$output"
	else
		echo "No data found"
	fi

	echo "Output of \"$ip rule show\""
	echo "$dash"
	output="$($ip rule show)"
	if [ "$output" != "" ]; then
		echo "$output"
	else
		echo "No data found"
	fi

	echo ""
	echo "Output of \"$ip route list table 1-250\""
	echo "$dash"
	local dump=0
	for i in $(seq 1 250); do
		output=$($ip route list table $i 2>/dev/null)
		if [ "$output" != "" ];then
			dump=1
			echo "Routing table $i:"
			echo "$output"
			echo ""
		fi
	done
	if [ "$dump" = "0" ]; then
		echo "No data found"
		echo ""
	fi

	echo "Output of \"nft list ruleset\""
	echo "$dash"
	output="$(nft list ruleset)"
	if [ "$output" != "" ]; then
		echo "$output"
	else
		echo "No data found"
	fi
}

start() {
	/etc/init.d/multiwan-nft enable || return
	/etc/init.d/multiwan-nft start
}

stop() {
	/etc/init.d/multiwan-nft disable || return
	/etc/init.d/multiwan-nft stop
}

restart() {
	/etc/init.d/multiwan-nft enable || return
	/etc/init.d/multiwan-nft stop || return
	/etc/init.d/multiwan-nft start
}

use() {
	local interface device src_ip family true_iface library
	if [ "$#" -lt 2 ] || [ -z "$1" ]; then
		echo "Usage: multiwan-nft use <interface> <command> [arguments...]" >&2
		return 2
	fi
	interface="$1"
	shift
	config_get family "$interface" family ipv4
	case "$family" in ipv4|ipv6) ;; *) echo "Invalid address family for interface $interface" >&2; return 1 ;; esac
	multiwan_nft_get_true_iface true_iface "$interface"
	network_get_device device "$true_iface"
	[ -n "$device" ] || { echo "Could not find device for $interface" >&2; return 1; }
	multiwan_nft_get_src_ip src_ip "$interface"
	case "$src_ip" in ''|0.0.0.0|::) echo "Could not find source address for $interface" >&2; return 1 ;; esac
	library="$MULTIWAN_NFT_LIB_ROOT/multiwan-nft/libwrap_mwan3_sockopt.so.1.0"
	[ -r "$library" ] || { echo "Interface binding library is missing: $library" >&2; return 1; }
	printf 'Running command through %s (device %s, source %s, family %s)\n' "$interface" "$device" "$src_ip" "$family" >&2
	FAMILY="$family" DEVICE="$device" SRCIP="$src_ip" FWMARK="$MMX_DEFAULT" \
		LD_PRELOAD="$library${LD_PRELOAD:+:$LD_PRELOAD}" exec "$@"
}

main() {
	local command="${1:-}" chains running
	case "$command" in
		''|help|-h|--help) help; return 0 ;;
		ifup|ifdown|use) ;;
		internal)
			if [ "$#" -gt 2 ] || { [ "$#" -eq 2 ] && [ "$2" != ipv4 ] && [ "$2" != ipv6 ]; }; then
				echo "Usage: multiwan-nft internal [ipv4|ipv6]" >&2
				return 2
			fi
			;;
		interfaces|policies|connected|rules|status|start|stop|restart)
			[ "$#" -eq 1 ] || { echo "Unexpected arguments for $command" >&2; return 2; }
			;;
		*) echo "Unknown command: $command" >&2; help >&2; return 2 ;;
	esac
	shift
	case "$command" in
		ifup|ifdown|start|stop|restart) ;;
		*) multiwan_nft_init readonly || return ;;
	esac
	case "$command" in
		interfaces|policies|connected|rules|status|internal)
			if multiwan_nft_reconfiguration_pending; then
				echo 'Warning: Routing configuration is incomplete. Affected connections remain blocked. Check the system log if this persists.'
			fi
			if [ "$command" != internal ]; then
				# A checked inventory distinguishes an absent hook from a failed read.
				chains="$($NFT list chains "$NFT_FAMILY")" || return
				running="$(printf '%s\n' "$chains" | awk -v family="$NFT_FAMILY" -v table="$NFT_TABLE" '
					$1 == "table" { owned = ($2 == family && $3 == table) }
					owned && $1 == "chain" && $2 == "multiwan_nft_hook" { found = 1 }
					END { print found + 0 }')" || return
				if [ "$running" -eq 0 ]; then
					echo 'MultiWAN NFT is stopped.'
					case "$command" in
						interfaces|status) config_foreach multiwan_nft_report_iface_status interface stopped || return ;;
					esac
					return 0
				fi
			fi
			;;
	esac
	"$command" "$@"
}

[ "${MULTIWAN_NFT_CLI_LIBRARY_ONLY:-0}" = 1 ] || main "$@"
