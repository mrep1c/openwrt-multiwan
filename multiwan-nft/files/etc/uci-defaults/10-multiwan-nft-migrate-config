#!/bin/sh

old_cfg="/etc/config/mwan3"
new_cfg="/etc/config/multiwan-nft"
old_user="/etc/mwan3.user"
new_user="/etc/multiwan-nft.user"
backup_suffix=".pre-multiwan-rename"

migrate_file() {
	local old_path="$1"
	local new_path="$2"

	[ -f "$old_path" ] || return 0

	cp -p "$old_path" "${old_path}${backup_suffix}" || return 1
	if [ -f "$new_path" ]; then cp -p "$new_path" "${new_path}${backup_suffix}" || return 1; fi
	mv "$old_path" "$new_path"
}

migrate_file "$old_cfg" "$new_cfg" || exit 1
migrate_file "$old_user" "$new_user" || exit 1

exit 0
