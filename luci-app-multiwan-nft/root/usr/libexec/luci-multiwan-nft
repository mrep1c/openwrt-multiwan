. /lib/functions.sh
. /lib/functions/network.sh
. /usr/share/libubox/jshn.sh
. /lib/multiwan-nft/common.sh

IIF=1000
FWMARK=2000
ID=0

usage() {
	local status="$1"
	local msg="$2"
	if [ -n "$msg" ]; then
		echo "$msg"
		echo ""
	fi
	echo "Usage: $(basename "$0") <command>"
	echo "command:"
	echo "  diag:   diagnostic commands"
	echo "  ipset:  nftset commands"
	echo ""
	echo "diag <command> <iface>"
	echo "command:"
	echo "  gateway <iface>:   ping interface gateway"
	echo "  tracking <iface>:  ping interface tracking targets"
	echo "  rules <iface>:     check interface routing rules"
	echo "  routes <iface>:    check interface routing tables"
	echo ""
	echo "ipset <command>"
	echo "command:"
	echo "  dump:     show all configured nft set names"

	exit "$status"
}

diag_gateway() {
	local iface="$1"
	local gw device family true_iface

	config_get family "$iface" family ipv4
	multiwan_nft_get_true_iface true_iface "$iface"
	if [ "$family" = ipv6 ]; then
		network_get_gateway6 gw "$true_iface"
	else
		network_get_gateway gw "$true_iface"
	fi

	[ -z "$gw" ] && {
		echo "No gateway for interface ${iface} found."
		exit 2
	}

	network_get_device device "$true_iface"

	[ -z "$device" ] && {
		echo "No device for interface ${iface} found."
		exit 2
	}

	echo "Pinging gateway $gw via device $device..."
	diag_ping "$family" -c 5 -W 1 -I "$device" "$gw"
}

diag_ping() {
	local family="$1"
	shift
	if [ "$family" = ipv6 ]; then
		if command -v ping6 >/dev/null 2>&1; then
			ping6 "$@"
		else
			ping -6 "$@"
		fi
	else
		ping "$@"
	fi
}

diag_tracking() {
	local iface="$1"
	local device family true_iface

	config_get family "$iface" family ipv4
	multiwan_nft_get_true_iface true_iface "$iface"
	network_get_device device "$true_iface"

	[ -z "$device" ] && {
		echo "No device for interface ${iface} found."
		exit 2
	}

	checkips() {
		local ip="$1"
		local device="$2"
		local family="$3"

		echo "Pinging tracking IP $ip via device $device..."
		diag_ping "$family" -c 5 -W 1 -I "$device" "$ip"
	}

	config_load 'multiwan-nft'
	config_list_foreach "$iface" "track_ip" checkips "$device" "$family"
}

iface_number() {
	local cfg="$1"
	local iface="$2"

	number=$((number + 1))

	[ "$cfg" = "$iface" ] && {
		ID="$number"
	}
}

diag_rules() {
	local iface="$1"
	local number=0 family IP device true_iface state rules iif_rule oif_rule fwmark_rule guard_rule

	config_load 'multiwan-nft'
	ID=0
	config_foreach iface_number 'interface' "$iface"

	[ "$ID" = "0" ] && {
		echo "Unable to get multiwan_nft interface number for \"$iface\"."
		exit 2
	}

	config_get family "$iface" family ipv4
	[ "$family" = ipv6 ] && IP="$IP6" || IP="$IP4"
	multiwan_nft_get_true_iface true_iface "$iface"
	network_get_device device "$true_iface"
	rules="$($IP rule list)" || return 1
	iif_rule="$(printf '%s\n' "$rules" | awk -v pref="$((IIF + ID)):" -v dev="$device" -v table="$ID" '$1 == pref && index($0, "iif " dev " ") && $NF == table')"
	oif_rule="$(printf '%s\n' "$rules" | awk -v pref="$((IIF + ID)):" -v dev="$device" -v table="$ID" '$1 == pref && index($0, "oif " dev " ") && $NF == table')"
	fwmark_rule="$(printf '%s\n' "$rules" | awk -v pref="$((FWMARK + ID)):" '$1 == pref')"
	guard_rule="$(printf '%s\n' "$rules" | awk -v pref="$((3000 + ID)):" '$1 == pref && $NF == "unreachable"')"
	state="$(cat "$MULTIWAN_NFT_STATUS_DIR/iface_state/$iface" 2>/dev/null)"

	if [ "$state" = offline ]; then
		if [ -n "$iif_rule" ] && [ -z "$fwmark_rule" ] && [ -n "$guard_rule" ]; then
			echo "All required IP rules for offline interface \"$iface\" found (isolated for recovery)"
		else
			echo "Incomplete offline isolation rules for interface \"$iface\""
		fi
	elif [ -n "$iif_rule" ] && [ -n "$oif_rule" ] && [ -n "$fwmark_rule" ] && [ -n "$guard_rule" ]; then
		echo "All required IP rules for interface \"$iface\" found"
	else
		echo "Incomplete IP rules for interface \"$iface\""
	fi
	printf '%s\n' "$rules" | awk -v iif="$((IIF + ID)):" -v mark="$((FWMARK + ID)):" -v guard="$((3000 + ID)):" '$1 == iif || $1 == mark || $1 == guard'
}

diag_routes() {
	local iface="$1"
	local table table_result family IP number=0

	config_load 'multiwan-nft'
	ID=0
	config_foreach iface_number 'interface' "$iface"

	[ "$ID" = "0" ] && {
		echo "Unable to get multiwan_nft interface number for \"$iface\"."
		exit 2
	}

	config_get family "$iface" family ipv4
	[ "$family" = ipv6 ] && IP="$IP6" || IP="$IP4"
	table="$($IP route list table "$ID")"
	table_result="$?"

	if [ "$table_result" = 0 ]; then
		echo "Routing table \"$ID\" for interface \"$iface\" found"
		echo "$table"
	else
		echo "Routing table \"$ID\" for interface \"$iface\" not found"
	fi
}

diag_cmd() {
	config_load 'multiwan-nft' || return 1
	case "$1" in
		gateway)
			diag_gateway "$2"
			;;
		tracking)
			diag_tracking "$2"
			;;
		rules)
			diag_rules "$2"
			;;
		routes)
			diag_routes "$2"
			;;
		*)
			usage "1" "Command not supported"
			;;
	esac
}

ipset_dump() {
	$NFT list table $NFT_FAMILY $NFT_TABLE 2>/dev/null | awk '$1 == "set" {print $2}' | grep -v '^multiwan_nft_' | sort -u
}

ipset_cmd() {
	case "$1" in
		dump)
			ipset_dump
			;;
		*)
			usage "1" "Command not supported"
			;;
	esac
}

main () {
	case "$1" in
		diag)
			diag_cmd "$2" "$3"
			;;
		ipset)
			ipset_cmd "$2"
			;;
		*)
			usage "1" "Command not supported"
			;;
	esac
}

main "$@"
